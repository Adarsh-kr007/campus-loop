# Server runtime
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection and JWT signing key (replace placeholders locally)
MONGODB_URI=mongodb+srv://<username>:<url-encoded-password>@<cluster>.mongodb.net/campusloop?retryWrites=true&w=majority
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# Comma-separated exact frontend origins; do not use a wildcard
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Required by npm run seed
ADMIN_NAME=Your Admin Name
ADMIN_EMAIL=admin@example.edu
ADMIN_STUDENT_ID=ADMIN001
ADMIN_PASSWORD=replace-with-a-unique-admin-password

# Required by npm run seed:sample
SEED_STUDENT_NAME=Sample Student
SEED_STUDENT_EMAIL=student@example.edu
SEED_STUDENT_ID=STUDENT001
SEED_STUDENT_PASSWORD=replace-with-a-unique-student-password

# Optional override for npm run test:api; must include the /api prefix
API_BASE_URL=http://127.0.0.1:5000/api
